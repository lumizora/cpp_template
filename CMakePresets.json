{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "sanitize", "inherits": "ci", "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CPP_TEMPLATE_SANITIZERS": "ON" }
    },
    {
      "name": "analyze", "inherits": "ci", "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CPP_TEMPLATE_CLANG_TIDY": "ON" }
    },
    {
      "name": "release", "inherits": "ci",
      "cacheVariables": { "CPP_TEMPLATE_PACKAGING": "ON" }
    },
    {
      "name": "default",
      "displayName": "Default",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },

    {
      "name": "offline",
      "displayName": "Offline (pre-fetched cache)",
      "inherits": "default",
      "cacheVariables": {
        "DEPS_OFFLINE": "ON"
      }
    },

    {
      "name": "ci",
      "displayName": "CI (no local overrides)",
      "inherits": "default",
      "cacheVariables": {
        "DEPS_ALLOW_OVERRIDE": "OFF",
        "DEPS_PREFER_PACKAGE": "OFF",
        "BUILD_TESTING": "ON",
        "CPP_TEMPLATE_WARNINGS_AS_ERRORS": "ON"
      }
    },

    {
      "name": "test",
      "displayName": "Tests (BUILD_TESTING=ON)",
      "inherits": "default",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },

    {
      "name": "bench",
      "displayName": "Benchmarks (BUILD_BENCHMARKING=ON)",
      "inherits": "default",
      "cacheVariables": {
        "BUILD_BENCHMARKING": "ON"
      }
    }
  ],

  "buildPresets": [
    { "name": "sanitize", "configurePreset": "sanitize", "configuration": "Debug" },
    { "name": "analyze", "configurePreset": "analyze", "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "test",
      "configurePreset": "test",
      "configuration": "Release"
    },
    {
      "name": "bench",
      "configurePreset": "bench",
      "configuration": "Release"
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Release"
    },
    {
      "name": "offline",
      "configurePreset": "offline",
      "configuration": "Release"
    }
  ],

  "testPresets": [
    { "name": "sanitize", "configurePreset": "sanitize", "configuration": "Debug",
      "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "release", "configurePreset": "release", "configuration": "Release",
      "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    {
      "name": "test",
      "configurePreset": "test",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
